PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/resumeforge

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Anthropic / Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# CORS
CLIENT_URL=http://localhost:5173

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
